# Copy to .env for local use. Never commit .env.
# Later portions add their variables here (see PRD Appendix E).

# test | staging | production
ENV=test

# postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://chatbot:change-me@localhost:5432/chatbot

# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# At least 32 characters. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Public address of this server. Must be https in production.
PUBLIC_BASE_URL=http://localhost:8000

# AI keys (optional; a company's model needs its key). Free Gemini keys: made-up data only.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Tests only: a login allowed to create databases. Each test makes and drops its own
# database (t_xxxxxxxxxxxx). See INSTRUCTION.md §5.1.
TEST_DATABASE_URL=postgresql://chatbot_test:change-me@localhost:5432/postgres
