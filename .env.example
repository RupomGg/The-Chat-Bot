# Copy to .env for local use. Never commit .env.
# Later portions add their variables here (see PRD Appendix E).

# test | staging | production
ENV=test

# postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://chatbot:change-me@localhost:5432/chatbot

# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# At least 32 characters. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Public address of this server. Must be https in production.
PUBLIC_BASE_URL=http://localhost:8000
